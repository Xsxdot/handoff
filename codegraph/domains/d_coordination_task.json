{
  "domain": "d_coordination_task",
  "responsibility": "为协调者保存任务、工单、事件和执行回合，并推进它们的合法状态迁移。",
  "invariants": [
    {
      "text": "任务状态只能沿 transitTable 登记的迁移边变化，completed 无后继而 failed 可重试回 running。",
      "testRef": "TestCanTransit"
    },
    {
      "text": "并发状态更新使用旧状态做 CAS，过期快照不能覆盖先发生的迁移。",
      "testRef": "TestUpdateTaskStateCAS"
    },
    {
      "text": "按工作目录统计活跃任务时只纳入非终态任务。",
      "testRef": "TestActiveTasksByWorkDirOnlyNonTerminal"
    },
    {
      "text": "任务进入终态时，剩余挂起工单被作废并留下终态审计痕迹。",
      "testRef": "TestTransitToTerminalVoidsPendingTickets"
    }
  ],
  "lifecycle": {
    "from": "internal/agentd/manager.go#Dispatch",
    "to": "internal/agentd/manager.go#transit"
  },
  "stateMachine": [
    {
      "from": "pending",
      "to": "running",
      "anchor": "internal/proto/proto.go#transitTable"
    },
    {
      "from": "pending",
      "to": "failed",
      "anchor": "internal/proto/proto.go#transitTable"
    },
    {
      "from": "running",
      "to": "waiting_answer",
      "anchor": "internal/proto/proto.go#transitTable"
    },
    {
      "from": "running",
      "to": "waiting_review",
      "anchor": "internal/proto/proto.go#transitTable"
    },
    {
      "from": "running",
      "to": "completed",
      "anchor": "internal/proto/proto.go#transitTable"
    },
    {
      "from": "running",
      "to": "failed",
      "anchor": "internal/proto/proto.go#transitTable"
    },
    {
      "from": "waiting_answer",
      "to": "running",
      "anchor": "internal/proto/proto.go#transitTable"
    },
    {
      "from": "waiting_answer",
      "to": "failed",
      "anchor": "internal/proto/proto.go#transitTable"
    },
    {
      "from": "waiting_review",
      "to": "running",
      "anchor": "internal/proto/proto.go#transitTable"
    },
    {
      "from": "waiting_review",
      "to": "completed",
      "anchor": "internal/proto/proto.go#transitTable"
    },
    {
      "from": "waiting_review",
      "to": "failed",
      "anchor": "internal/proto/proto.go#transitTable"
    },
    {
      "from": "failed",
      "to": "running",
      "anchor": "internal/proto/proto.go#transitTable"
    }
  ]
}
