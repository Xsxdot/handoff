{
  "meta": {
    "version": 1,
    "project": "handoff"
  },
  "domains": {
    "d_orchestration": {
      "label": "任务编排",
      "responsibility": "为协调者把一次派发从 pending 推进到终态：状态机迁移与 CAS、工单审批、事件留痕与实时分发、断线回收与状态对账、以及这一切的 SQLite 持久化。",
      "type": "logic"
    },
    "d_gateway": {
      "label": "控制门面",
      "responsibility": "为 CLI 与浏览器把本机能力经 HTTP/WS 暴露出去：鉴权、路由、参数校验、响应编排与跨机转发；不含业务决策。",
      "type": "boundary"
    },
    "d_workspace": {
      "label": "项目与工作区",
      "responsibility": "为任务提供项目身份登记、工作树准备与回收、分支跨机同步、机器镜像发现与工作台启动项，把 git 与文件系统的现实隔离在协作语义之外。",
      "type": "boundary"
    },
    "d_execution": {
      "label": "任务执行",
      "responsibility": "把任务在执行机上真正跑起来：按统一契约驱动各家模型执行器、把输出收敛成回合协议、承载 detached 进程树并保证残留可回收。",
      "type": "boundary"
    },
    "d_sessions": {
      "label": "终端会话",
      "responsibility": "为协调者提供可附着的本机 PTY 会话：会话生命周期、实时输出订阅、历史回放与磁盘落点，跨 agentd 重启可收养。",
      "type": "boundary"
    },
    "d_transport": {
      "label": "跨机连接",
      "responsibility": "为协调者与执行机建立可靠通道：目标选择与客户端复用、直连与 relay 隧道、代理配置翻译。",
      "type": "boundary"
    },
    "d_protocol": {
      "label": "协议契约",
      "responsibility": "为控制面、执行器与控制台定义跨进程交换的数据契约与任务状态迁移表，是 wire 类型的唯一定义处。",
      "type": "logic"
    },
    "d_ledger": {
      "label": "卡片账本",
      "responsibility": "为协调者保存需求卡、类型化关系、工作流定义与裁决的可审计账本，并把挂账任务的事件镜像回账本；与执行域仅弱引用隔离。",
      "type": "logic"
    },
    "d_collab": {
      "label": "协作房间",
      "responsibility": "为控制台与 CLI 播发协作房间消息并执法其白名单与书写者规则：卡会话/项目群/全员群三级房间、@定向消费队列、未读游标与待回复收件箱的读模型。与 d_sessions（终端 PTY 回放）同名不同物——本域管协作房间，不管 PTY；房间消息落账本 card_events 单流，绑定席位权威在账本卡上（B156.2）。",
      "type": "logic"
    },
    "d_cli": {
      "label": "协调者命令面",
      "responsibility": "把协调者的终端意图翻译成 client/agentd 调用，并以可脚本化的文本契约呈现结果。",
      "type": "logic"
    },
    "d_web": {
      "label": "Web 控制台",
      "responsibility": "为协调者提供任务指挥、执行回放、账本看板与工作台交互的浏览器界面。",
      "type": "logic"
    },
    "d_policy": {
      "label": "运行策略与配置",
      "responsibility": "决定本机如何运转：可信配置的加载与持久化、权限放行判据、执行纪律块、环境注入与首次配置问答。",
      "type": "logic"
    },
    "d_maintenance": {
      "label": "安装与换版",
      "responsibility": "把正确版本的二进制与技能落到每台机器：能力探测、发布资产下载校验、自升级判据与执行、系统服务托管。",
      "type": "boundary"
    },
    "d_scheduling": {
      "label": "编制调度",
      "responsibility": "为工作流节点点火与协调者拉起裁定并发资格：载体（机×CLI×HOME×模型×凭据×上限）与小队的一等登记与版本化、两级并发准入（小队政策位+载体物理位，协调者准入优先、不抢占在跑）、点火请求的持久排队与按就绪度出队——把「谁能现在跑」从任务状态机里分离出来。",
      "type": "logic"
    },
    "d_keystone": {
      "label": "协调者 Keystone",
      "responsibility": "替手替眼的机器协调者控制面：开卡即绑/一键拉起两入口、消费 card_events 单流做唤醒决策（该不该醒、同卡合并、attach 人工接管互斥）、无头 resume 与 attach 定位双通道、失败兜底降级链（resume→重建四步→转等人）；不拥有持久数据，只做编排决策。",
      "type": "logic"
    },
    "d_execution_contract": {
      "label": "执行契约",
      "responsibility": "定义 executor 挂载契约（Adapter 接口、事件与结果类型）与教模型用的回合帧协议，是执行域对编排域的唯一承诺面。",
      "parent": "d_execution"
    },
    "d_execution_adapters": {
      "label": "执行器适配",
      "responsibility": "把 claude/codex/grok/opencode 四家模型 CLI 的启动、输出、权限请求和终态差异收敛成统一契约；含 fake 脚本化实现与 rawtap 原始字节旁路。",
      "parent": "d_execution"
    },
    "d_execution_host": {
      "label": "进程承载",
      "responsibility": "为 detached 执行进程提供跨平台的启动、锁与凭据、资源围栏采样和进程树回收原语。",
      "parent": "d_execution"
    },
    "d_transport_channel": {
      "label": "客户端路由",
      "responsibility": "把任务、项目、机器和会话操作路由到目标 agentd：单机客户端封装与按 target 复用的连接池。",
      "parent": "d_transport"
    },
    "d_transport_tunnel": {
      "label": "直连与中继",
      "responsibility": "在直连与 relay 场景下建立可复用的网络通道：懒拨号隧道与代理传输生成。",
      "parent": "d_transport"
    },
    "d_web_contract": {
      "label": "控制台契约层",
      "responsibility": "后端 wire 契约在 TS 侧的镜像与请求函数：HTTP 客户端、WS 帧、PTY 与账本 API。",
      "parent": "d_web"
    },
    "d_web_command": {
      "label": "任务指挥",
      "responsibility": "任务看板、任务详情与审阅流、全局工单弹层——协调者盯任务和做裁决的界面。",
      "parent": "d_web"
    },
    "d_web_workbench": {
      "label": "工作台",
      "responsibility": "文件树、工作树管理、多面板工作区与 home 基准终端——协调者在浏览器里的操作现场。",
      "parent": "d_web"
    },
    "d_web_cards": {
      "label": "账本看板",
      "responsibility": "需求卡看板与工作流编辑器——账本域在控制台的操作面。",
      "parent": "d_web"
    },
    "d_web_admin": {
      "label": "机器与设置",
      "responsibility": "机器详情与纪律/环境配置、项目登记、设置页、版本更新提示与代码图诊断页。",
      "parent": "d_web"
    },
    "d_web_shell": {
      "label": "壳与共用",
      "responsibility": "应用壳、布局、共用组件与数据钩子、工具函数，以及静态资产的 Go 侧打包形态。",
      "parent": "d_web"
    }
  },
