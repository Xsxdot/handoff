{
  "meta": {
    "version": 1,
    "project": "handoff"
  },
  "domains": [
    {
      "id": "d_ledger",
      "name": "账本域",
      "type": "logic",
      "paths": [
        "internal/ledger/**",
        "internal/ledgerstep/**",
        "internal/ledgermirror/**",
        "internal/store/**"
      ]
    },
    {
      "id": "d_controlplane",
      "name": "控制面 API 域",
      "type": "logic",
      "paths": [
        "internal/agentd/**",
        "internal/webui/**"
      ],
      "note": "待竖切：61 文件平铺包，实例化清单 §5.1/§6 已立待办，竖切前整包归一域"
    },
    {
      "id": "d_remote",
      "name": "远端连接域",
      "type": "boundary",
      "paths": [
        "internal/client/**",
        "internal/targetclient/**",
        "internal/relay/**",
        "internal/proxycfg/**"
      ]
    },
    {
      "id": "d_executor",
      "name": "Executor 适配域",
      "type": "boundary",
      "paths": [
        "internal/executor/**"
      ]
    },
    {
      "id": "d_host",
      "name": "宿主进程与 PTY 域",
      "type": "boundary",
      "paths": [
        "internal/prochost/**",
        "internal/ptyhost/**"
      ]
    },
    {
      "id": "d_release",
      "name": "换版与发布域",
      "type": "boundary",
      "paths": [
        "internal/release/**",
        "internal/upgrade/**",
        "internal/selfupdate/**"
      ]
    },
    {
      "id": "d_localint",
      "name": "本机集成域",
      "type": "boundary",
      "paths": [
        "internal/service/**",
        "internal/toolchain/**",
        "internal/pathenv/**",
        "internal/envfile/**",
        "internal/launcher/**",
        "internal/permgate/**",
        "internal/initflow/**",
        "internal/localsync/**",
        "internal/skill/**",
        "internal/config/**",
        "internal/logx/**"
      ]
    },
    {
      "id": "d_cli",
      "name": "CLI 域",
      "type": "logic",
      "paths": [
        "cmd/**"
      ]
    },
    {
      "id": "d_web",
      "name": "Web 控制台域",
      "type": "logic",
      "paths": [
        "web/src/**"
      ]
    },
    {
      "id": "d_contract",
      "name": "契约域",
      "type": "logic",
      "paths": [
        "internal/proto/**",
        "internal/buildinfo/**",
        "internal/projectid/**",
        "internal/discipline/**"
      ]
    }
  ],
