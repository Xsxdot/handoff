{
  "meta": {
    "version": 2,
    "project": "handoff"
  },
  "subsystems": [
    {
      "id": "d_ledger",
      "name": "账本域",
      "type": "logic",
      "paths": [
        "internal/ledger/**",
        "internal/ledgerstep/**",
        "internal/ledgermirror/**",
        "internal/store/**"
      ]
    },
    {
      "id": "d_controlplane",
      "name": "控制面 API 域",
      "type": "logic",
      "paths": [
        "internal/agentd/**",
        "internal/webui/**"
      ],
      "note": "待竖切：61 文件平铺包，实例化清单 §5.1/§6 已立待办，竖切前整包归一域；B205 工作树挂卡仍经 ledger.Store 门面，账本未启用时建树照常"
    },
    {
      "id": "d_remote",
      "name": "远端连接域",
      "type": "boundary",
      "paths": [
        "internal/client/**",
        "internal/targetclient/**",
        "internal/relay/**",
        "internal/proxycfg/**"
      ]
    },
    {
      "id": "d_executor",
      "name": "Executor 适配域",
      "type": "boundary",
      "paths": [
        "internal/executor/**"
      ]
    },
    {
      "id": "d_host",
      "name": "宿主进程与 PTY 域",
      "type": "boundary",
      "paths": [
        "internal/prochost/**",
        "internal/ptyhost/**"
      ]
    },
    {
      "id": "d_release",
      "name": "换版与发布域",
      "type": "boundary",
      "paths": [
        "internal/release/**",
        "internal/upgrade/**",
        "internal/selfupdate/**"
      ]
    },
    {
      "id": "d_localint",
      "name": "本机集成域",
      "type": "boundary",
      "paths": [
        "internal/service/**",
        "internal/toolchain/**",
        "internal/pathenv/**",
        "internal/envfile/**",
        "internal/launcher/**",
        "internal/permgate/**",
        "internal/initflow/**",
        "internal/localsync/**",
        "internal/skill/**",
        "internal/config/**",
        "internal/logx/**"
      ]
    },
    {
      "id": "d_cli",
      "name": "CLI 域",
      "type": "logic",
      "paths": [
        "cmd/**"
      ]
    },
    {
      "id": "d_web",
      "name": "Web 控制台域",
      "type": "logic",
      "paths": [
        "web/src/**"
      ]
    },
    {
      "id": "d_contract",
      "name": "契约域",
      "type": "logic",
      "paths": [
        "internal/proto/**",
        "internal/buildinfo/**",
        "internal/projectid/**",
        "internal/discipline/**"
      ]
    }
  ],
  "assembly": [
    "main.go"
  ],
  "contracts": [
    {
      "from": "d_cli",
      "to": "d_contract",
      "entries": [
        "proto 实体",
        "proto.TaskState"
      ],
      "legacyBudget": 4
    },
    {
      "from": "d_cli",
      "to": "d_controlplane",
      "legacyBudget": 12
    },
    {
      "from": "d_cli",
      "to": "d_executor",
      "legacyBudget": 7
    },
    {
      "from": "d_cli",
      "to": "d_host",
      "legacyBudget": 6
    },
    {
      "from": "d_cli",
      "to": "d_ledger",
      "entries": [
        "ledger.Store"
      ],
      "legacyBudget": 1
    },
    {
      "from": "d_cli",
      "to": "d_localint",
      "entries": [
        "config 实体",
        "config.Target",
        "localsync 实体"
      ],
      "legacyBudget": 35
    },
    {
      "from": "d_cli",
      "to": "d_release",
      "legacyBudget": 8
    },
    {
      "from": "d_cli",
      "to": "d_remote",
      "entries": [
        "client 实体",
        "client.Client"
      ],
      "legacyBudget": 10
    },
    {
      "from": "d_controlplane",
      "to": "d_contract",
      "entries": [
        "discipline.Resolver",
        "proto 实体",
        "proto.Task"
      ],
      "legacyBudget": 19
    },
    {
      "from": "d_controlplane",
      "to": "d_executor",
      "entries": [
        "executor 实体"
      ],
      "legacyBudget": 3
    },
    {
      "from": "d_controlplane",
      "to": "d_host",
      "entries": [
        "ptyhost 实体",
        "ptyhost.Host"
      ],
      "legacyBudget": 16
    },
    {
      "from": "d_controlplane",
      "to": "d_ledger",
      "entries": [
        "ledger.Store",
        "store.Store"
      ],
      "legacyBudget": 3
    },
    {
      "from": "d_controlplane",
      "to": "d_localint",
      "entries": [
        "config 实体",
        "permgate 实体"
      ],
      "legacyBudget": 18
    },
    {
      "from": "d_controlplane",
      "to": "d_release",
      "legacyBudget": 14
    },
    {
      "from": "d_controlplane",
      "to": "d_remote",
      "entries": [
        "targetclient.Pool"
      ],
      "legacyBudget": 6
    },
    {
      "from": "d_executor",
      "to": "d_contract",
      "entries": [
        "proto 实体",
        "proto.Task"
      ]
    },
    {
      "from": "d_executor",
      "to": "d_host",
      "legacyBudget": 9
    },
    {
      "from": "d_ledger",
      "to": "d_contract",
      "entries": [
        "proto 实体"
      ],
      "legacyBudget": 2
    },
    {
      "from": "d_localint",
      "to": "d_remote",
      "legacyBudget": 2
    },
    {
      "from": "d_release",
      "to": "d_localint",
      "legacyBudget": 1
    },
    {
      "from": "d_release",
      "to": "d_remote",
      "entries": [
        "client.Client"
      ]
    },
    {
      "from": "d_remote",
      "to": "d_contract",
      "entries": [
        "proto 实体"
      ]
    },
    {
      "from": "d_remote",
      "to": "d_localint",
      "entries": [
        "config 实体",
        "config.Target"
      ]
    }
  ]
}
