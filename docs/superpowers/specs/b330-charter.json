      "finish": "结束",
      "implement": "进行中",
      "integrate": "审核中",
      "plan": "进行中",
      "review": "审核中",
      "spec": "沟通中",
      "图对账": "审核中",
      "已出 spec": "沟通中",
      "已出spec": "沟通中",
      "已完成": "结束",
      "待办": "代办",
      "待合并": "审核中",
      "待审阅": "审核中",
      "终止": "结束",
      "进行中": "进行中"
