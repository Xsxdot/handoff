+.tk.flash{animation:tk-flash 1.4s ease-out 1}
+@keyframes tk-flash{0%{box-shadow:0 0 0 7px color-mix(in srgb,var(--st-need) 45%,transparent)}100%{box-shadow:0 0 0 3px color-mix(in srgb,var(--st-need) 26%,transparent)}}
+@media (prefers-reduced-motion:reduce){.tk.flash{animation:none}}
+.tk-top{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
