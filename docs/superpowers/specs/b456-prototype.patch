ound:#f0f1f2;color:#282c30;font-weight:600}.pane-head{height:30px;border-bottom:1px solid #e6e8eb;display:flex;align-items:center;padding:0 9px;font-weight:600}.pane-actions{margin-left:auto;color:#777;letter-spacing:5px}.chat{flex:1;min-height:0;overflow:auto;background:#fafbfc;padding:14px 14px}.messages{max-width:950px;display:flex;flex-direction:column;gap:13px}.message{background:white;border:1px solid #e7e9eb;border-radius:12px;padding:10px 12px;box-shadow:0 1px 2px #0000000b;font-size:12.5px;line-height:1.5}.meta{font-size:10px;color:#8b9096;margin-bottom:3px}.composer-wrap{padding:7px 10px 5px;background:#fafbfc}.composer{border:1px solid #e4e7e9;background:#fff;border-radius:14px;min-height:48px;padding:7px 9px;display:flex;align-items:center;gap:9px}.composer textarea{border:0;outline:0;resize:none;flex:1;min-width:0;height:27px;padding:5px 2px}.tool{color:#777;font-size:16px}.send{border:0;border-radius:16px;background:#22272d;color:white;padding:7px 14px}.quota{height:14px;border-top:1px solid #e9ebed;background:#f7f8f9;color:#888;font-size:9px;padding-left:8px;flex:none}
