+.casebar{display:flex;align-items:center;gap:8px;padding:4px 10px;border-bottom:1px solid #eceef0;background:#fff;flex-wrap:wrap}
+.casebar label{color:#777}
+.casebar select,.casebar button{height:24px;border:1px solid #e2e5e8;border-radius:5px;background:white;padding:2px 7px;cursor:pointer}
+.casebar .mock-note{margin-left:auto;color:#888;font-size:10px}
+.mock-added{align-self:flex-end;max-width:70%;background:#f0f1f2;padding:9px 12px;border-radius:12px}
+
+/* 状态图标：12px 视框，currentColor 上色 */
+.st-ic{display:inline-flex;width:12px;height:12px;flex:none}
+.st-ic svg{width:100%;height:100%;display:block}
+.s-run{--st:var(--st-run);--st-t:var(--st-run-text)}
+.s-idle{--st:var(--st-idle);--st-t:var(--st-idle-text)}
+.s-need{--st:var(--st-need);--st-t:var(--st-need-text)}
+.s-wait{--st:var(--st-wait);--st-t:var(--st-wait-text)}
+.s-err{--st:var(--st-err);--st-t:var(--st-err-text)}
+.s-unk{--st:var(--st-unk);--st-t:var(--st-unk-text)}
+.st-ic{color:var(--st)}
+
+/* 头像 + 角标 */
+.av{position:relative;flex:none;width:22px;height:22px;border-radius:50%;display:grid;place-items:center;background:var(--muted);color:var(--foreground);font-size:10.5px;font-weight:500;line-height:1}
+.av .badge{position:absolute;right:-5px;bottom:-4px;width:12px;height:12px;border-radius:50%;background:var(--background);display:grid;place-items:center;box-shadow:0 0 0 1px var(--background)}
+.av .badge .st-ic{width:10px;height:10px}
+.s-run .av .badge::after{content:"";position:absolute;inset:0;border-radius:50%;box-shadow:0 0 0 0 var(--st-run);animation:run-pulse 2.4s ease-out infinite}
+@keyframes run-pulse{0%{box-shadow:0 0 0 0 color-mix(in srgb,var(--st-run) 55%,transparent)}70%,100%{box-shadow:0 0 0 5px transparent}}
+@media (prefers-reduced-motion:reduce){.s-run .av .badge::after{animation:none}}
+.av.lg{width:30px;height:30px;font-size:13px}
+.av.lg .badge{width:15px;height:15px;right:-5px;bottom:-4px}
+.av.lg .badge .st-ic{width:12px;height:12px}
+.av.card{border-radius:7px}
+
+/* ---- 状态条 ---- */
+.status-area{padding:0 10px 7px;background:#fafbfc}
+.role-strip{min-height:36px;display:flex;align-items:center;gap:0;border:1px solid var(--border);background:var(--background);border-radius:10px;padding:3px 4px 3px 4px;color:var(--foreground)}
+.strip-lead{flex:0 1 auto;min-width:0;display:flex;align-items:center;gap:6px;padding-right:8px}
+.need-cta{flex:none;display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 10px 0 8px;border:0;border-radius:7px;background:var(--st-need);color:var(--st-need-ink);font-weight:600;cursor:pointer;white-space:nowrap}
+.need-cta .st-ic{color:var(--st-need-ink)}
+.need-cta b{display:inline-grid;place-items:center;min-width:17px;height:17px;padding:0 4px;border-radius:9px;background:var(--st-need-ink);color:var(--st-need);font-size:11px}
+.need-cta:hover{filter:brightness(.96)}
+.banner{display:flex;align-items:flex-start;gap:6px;min-width:0;border:0;background:none;padding:4px 6px;border-radius:7px;text-align:left;cursor:pointer;color:var(--foreground);line-height:1.45}
+.banner .st-ic{margin-top:2px}
+.banner:hover{background:var(--muted)}
+.banner:hover .banner-text{text-decoration:underline;text-decoration-color:color-mix(in srgb,currentColor 35%,transparent);text-underline-offset:3px}
+.banner.quiet{color:var(--muted-foreground)}
+.role-strip.measuring .strip-lead{flex:none!important;max-width:none}.role-strip.measuring .banner-text{white-space:nowrap}
+.banner.s-err .banner-text{color:var(--st-err-text);font-weight:500}
+.strip-roster{flex:1 1 0;min-width:150px;display:flex;align-items:center;gap:4px;border-left:1px solid var(--border);padding-left:6px;align-self:stretch}
+.chips{flex:1 1 0;min-width:0;display:flex;align-items:center;gap:4px;overflow:hidden}
+.chip{flex:none;display:inline-flex;align-items:center;gap:5px;height:30px;padding:0 8px 0 4px;border:1px solid transparent;border-radius:8px;background:transparent;color:var(--muted-foreground);white-space:nowrap;cursor:pointer}
+.chip[hidden]{display:none}
+.chip.mini{padding:0 8px 0 5px;gap:0}.chip.mini .av{margin-right:0}.chip.mini .chip-name,.chip.mini .chip-state,.chip.mini .chip-dur{display:none}.chip.nodur .chip-dur{display:none}
+.chip-tag{display:none;margin-left:8px;font-size:10px;color:var(--muted-foreground);font-variant-numeric:tabular-nums}.chip.mini .chip-tag{display:inline}
+.chip .av{margin-right:4px;font-size:10.5px}
+.chip-name{color:var(--foreground)}
+.chip-state{color:var(--st-t);font-weight:500}
+.chip-dur{color:var(--muted-foreground);font-variant-numeric:tabular-nums}
+.chip:hover{background:var(--muted)}
+.chip.s-idle .chip-name,.chip.s-unk .chip-name{color:var(--muted-foreground)}
+.chip.s-need{background:color-mix(in srgb,var(--st-need) 14%,var(--background));border-color:color-mix(in srgb,var(--st-need) 50%,transparent)}
+.chip.s-err{background:color-mix(in srgb,var(--st-err) 11%,var(--background));border-color:color-mix(in srgb,var(--st-err) 45%,transparent)}
+.chip.s-need .chip-state,.chip.s-err .chip-state{font-weight:600}
+.chip.s-need:hover{background:color-mix(in srgb,var(--st-need) 22%,var(--background))}
+.chip.s-err:hover{background:color-mix(in srgb,var(--st-err) 17%,var(--background))}
+.more{flex:none;height:26px;min-width:34px;padding:0 8px;border:1px solid var(--border);border-radius:7px;background:var(--background);color:var(--muted-foreground);cursor:pointer;font-variant-numeric:tabular-nums}
+.more[hidden]{display:none}
+.more:hover,.more[aria-expanded="true"]{color:var(--foreground);background:var(--muted)}
+.more .more-dot{display:inline-block;width:6px;height:6px;border-radius:50%;margin-left:4px;vertical-align:1px;background:var(--st)}
+:is(.need-cta,.banner,.chip,.more,.pop-row,.btn,.icon-x,.tk-btn):focus-visible{outline:2px solid var(--st-wait);outline-offset:1px}
+
+/* 提示（hover / 聚焦） */
+.tip{position:fixed;z-index:80;max-width:280px;padding:7px 9px;border-radius:7px;background:#25292e;color:#f2f3f4;font-size:11.5px;line-height:1.5;box-shadow:0 6px 18px rgba(0,0,0,.2);pointer-events:none}
+html.dark .tip{background:#f0f1f2;color:#1c1d1f}
+.tip[hidden]{display:none}
+.tip b{font-weight:600}
+.tip .tip-sub{opacity:.8}
+
+/* 「+N」弹层：全部角色，按紧急度排 */
+.more-pop{position:fixed;z-index:60;width:360px;max-width:calc(100vw - 16px);max-height:min(60dvh,460px);overflow:auto;padding:6px;background:var(--background);color:var(--foreground);border:1px solid var(--border);border-radius:10px;box-shadow:var(--pop-shadow)}
+.more-pop[hidden]{display:none}
+.pop-head{display:flex;align-items:center;padding:6px 8px 6px;font-weight:600}
+.pop-head span{margin-left:auto;font-weight:400;color:var(--muted-foreground);font-size:11px}
+.pop-row{display:grid;grid-template-columns:24px 1fr auto;gap:2px 9px;align-items:center;width:100%;padding:7px 8px;border:0;border-radius:7px;background:none;text-align:left;cursor:pointer;color:inherit}
+.pop-row:hover{background:var(--muted)}
+.pop-row.s-need{box-shadow:inset 3px 0 0 var(--st-need)}
+.pop-row.s-err{box-shadow:inset 3px 0 0 var(--st-err)}
+.pop-row .pr-name{font-weight:500}
+.pop-row .pr-state{display:inline-flex;align-items:center;gap:4px;color:var(--st-t);font-weight:500;white-space:nowrap}
+.pop-row .pr-note{grid-column:2 / 4;color:var(--muted-foreground);font-size:11.5px;line-height:1.45}
+.pop-row .pr-dur{color:var(--muted-foreground);font-weight:400}
+
+/* ---- 角色详情：结论 / 原因 / 你可以做什么 + 折叠的技术细节 ---- */
+.role-dialog,.sheet{border:1px solid var(--border);background:var(--background);color:var(--foreground);padding:0;box-shadow:0 14px 44px rgba(0,0,0,.18)}
+.role-dialog{width:min(520px,calc(100vw - 24px));max-height:min(86dvh,760px);border-radius:12px;overflow:hidden;display:none;flex-direction:column}
+.role-dialog[open]{display:flex}
+.role-dialog::backdrop,.sheet::backdrop{background:#20252a38}
+.role-dialog::before{content:"";flex:none;height:3px;background:var(--st,transparent)}
+.dlg-head{flex:none;display:flex;align-items:center;gap:11px;padding:13px 14px 11px}
+.dlg-title{min-width:0}
+.dlg-title h2{font-size:14.5px;margin:0;font-weight:600}
+.dlg-sub{display:flex;flex-wrap:wrap;align-items:center;gap:4px 10px;margin-top:3px;color:var(--muted-foreground);font-size:11.5px}
+.state-pill{display:inline-flex;align-items:center;gap:5px;height:20px;padding:0 7px 0 5px;border-radius:10px;background:color-mix(in srgb,var(--st) 13%,var(--background));color:var(--st-t);font-weight:600;font-size:11.5px}
+.icon-x{margin-left:auto;align-self:flex-start;width:28px;height:28px;border:0;border-radius:7px;background:none;color:var(--muted-foreground);font-size:19px;line-height:1;cursor:pointer}
+.icon-x:hover{background:var(--muted);color:var(--foreground)}
+.dlg-body{overflow:auto;min-height:0;padding:2px 16px 16px}
+.verdict{font-size:15px;line-height:1.55;font-weight:600;margin:2px 0 14px}
+.dsec{border-top:1px solid var(--border);padding:11px 0 0;margin-top:11px}
+.dsec h3{margin:0 0 4px;font-size:11.5px;font-weight:500;color:var(--muted-foreground)}
+.dsec p{margin:0;font-size:13px;line-height:1.6}
+.acts{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px}
+.btn{height:30px;padding:0 12px;border:1px solid var(--border);border-radius:7px;background:var(--background);color:var(--foreground);cursor:pointer;font-weight:500}
+.btn:hover{background:var(--muted)}
+.btn.primary{background:var(--foreground);color:var(--background);border-color:var(--foreground)}
+.btn.primary:hover{opacity:.9}
+.btn.need{background:var(--st-need);border-color:var(--st-need);color:var(--st-need-ink)}
+.btn[disabled]{opacity:.55;cursor:default}
+.feedback{margin:9px 0 0;padding:7px 9px;border-radius:7px;background:var(--muted);font-size:12px;line-height:1.5}
+.feedback[hidden]{display:none}
+.feedback.ok{background:color-mix(in srgb,var(--st-run) 12%,var(--background));color:var(--st-run-text)}
+.feed{list-style:none;margin:2px 0 0;padding:0}
+.feed li{display:grid;grid-template-columns:44px 1fr;gap:8px;padding:3px 0;font-size:12.5px;line-height:1.5;color:var(--muted-foreground)}
+.feed li time{font-variant-numeric:tabular-nums;font-size:11.5px;padding-top:1px}
+.feed li span{display:flex;align-items:flex-start;gap:5px;min-width:0;overflow-wrap:anywhere}
+.feed li span .st-ic{margin-top:3px}
+.feed li.f-err,.feed li.f-need{color:var(--st-t);font-weight:500}
+.feed li.f-more{display:block;padding-left:52px;font-size:11.5px;opacity:.8;cursor:default}
+.feed-note{margin:0 0 4px;font-size:11.5px;color:var(--muted-foreground)}
+.dmeta{margin-top:13px;color:var(--muted-foreground);font-size:11px}
+.tech{margin-top:12px;border:1px solid var(--border);border-radius:8px}
+.tech>summary{cursor:pointer;padding:8px 10px;color:var(--muted-foreground);font-size:12px;list-style:none;display:flex;align-items:center;gap:6px}
+.tech>summary::-webkit-details-marker{display:none}
+.tech>summary::before{content:"›";display:inline-block;transition:transform .15s}
+.tech[open]>summary::before{transform:rotate(90deg)}
+.tech[open]>summary{border-bottom:1px solid var(--border)}
+.tech-body{padding:9px 10px 10px;font-size:11.5px}
+.tech dl{display:grid;grid-template-columns:auto 1fr;gap:4px 12px;margin:0 0 9px}
+.tech dt{color:var(--muted-foreground)}
+.tech dd{margin:0;font-family:var(--mono);font-size:11px;overflow-wrap:anywhere}
+.tech h4{margin:9px 0 4px;font-size:11px;font-weight:500;color:var(--muted-foreground)}
+.tech ol{list-style:none;margin:0;padding:0}
+.tech li{display:grid;grid-template-columns:62px 1fr;gap:8px;padding:3px 0;line-height:1.5}
+.tech li time{font-family:var(--mono);font-size:10.5px;color:var(--muted-foreground);padding-top:1px}
+.tech pre{margin:0;white-space:pre-wrap;overflow-wrap:anywhere;padding:7px 9px;border-radius:6px;background:var(--muted);font:11px/1.5 var(--mono)}
+.tech pre.err{background:color-mix(in srgb,var(--st-err) 10%,var(--background));color:var(--st-err-text)}
+
+/* ---- 待你处理：工单面板（右侧抽屉，形同控制台 TicketsPanel） ---- */
+.sheet{margin:0 0 0 auto;height:100dvh;max-height:100dvh;width:min(440px,100vw);max-width:100vw;border-radius:12px 0 0 12px;border-right:0;display:none;flex-direction:column}
+.sheet[open]{display:flex}
+.sheet-head{flex:none;padding:13px 14px 10px;border-bottom:1px solid var(--border)}
+.sheet-head .row{display:flex;align-items:center;gap:8px}
+.sheet-head h2{margin:0;font-size:14.5px}
