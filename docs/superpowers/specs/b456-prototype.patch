+.tk label span{display:block;font-size:11px;color:var(--muted-foreground);margin-bottom:3px}
+.tk-acts{display:flex;gap:7px;flex-wrap:wrap}
+.tk-btn{height:28px;padding:0 11px;border-radius:7px;border:1px solid var(--border);background:var(--background);cursor:pointer;font-weight:500}
+.tk-btn.primary{background:var(--foreground);color:var(--background);border-color:var(--foreground)}
+.tk-btn.danger{background:var(--st-err);border-color:var(--st-err);color:#fff}
+.tk-btn[disabled]{opacity:.5;cursor:default}
+.tk-err{font-size:11.5px;color:var(--st-err-text);margin:0}
+.tk.done{opacity:.7}
+.tk-done{font-size:12px;color:var(--st-run-text);font-weight:500}
