+.role-dialog[open]{display:flex}
+.role-dialog .dialog-head{flex:none}
+.role-dialog .dialog-body{overflow:auto;min-height:0}
+.detail-tabs{display:flex;gap:5px;border-bottom:1px solid #e9ebed;margin:-2px 0 12px;padding-bottom:7px}
+.detail-tabs button{border:1px solid transparent;background:transparent;border-radius:6px;padding:5px 9px;color:#777;cursor:pointer}
+.detail-tabs button[aria-selected="true"]{background:#f0f1f2;color:#333;border-color:#e5e7e9;font-weight:600}
+.detail-pane[hidden]{display:none!important}
+.detail-pane dl{margin:0}
+.timeline-jump{display:inline-block;margin-top:14px;color:#50565d;text-decoration:underline;text-underline-offset:2px}
+.mock-caption{color:#777;font-size:11px;margin:0 0 10px}
+.timeline-round{border:1px solid #e7e9eb;border-radius:8px;margin:0 0 8px;background:#fff}
+.timeline-round>summary{display:flex;align-items:center;gap:12px;padding:9px 10px;cursor:pointer;list-style:none}
+.timeline-round>summary::-webkit-details-marker{display:none}
+.timeline-round>summary span{display:flex;flex-direction:column;gap:2px;min-width:0}
+.timeline-round>summary small,.timeline-event summary small{color:#858a90;font-size:10px}
+.timeline-round>summary em{font-style:normal;color:#666;margin-left:auto;text-align:right;font-size:11px}
+.round-events{padding:0 9px 8px 16px;border-top:1px solid #eff0f1}
+.timeline-event{border-left:1px solid #dfe2e5;margin:8px 0 0;padding-left:9px}
+.timeline-event>summary{display:flex;align-items:baseline;gap:8px;cursor:pointer;list-style:none;flex-wrap:wrap}
+.timeline-event>summary::-webkit-details-marker{display:none}
+.timeline-event time{font-size:10px;color:#858a90;min-width:48px}
+.timeline-event summary b{font-size:11px;font-weight:600}
+.timeline-event summary small{margin-left:auto}
+.event-content{margin:5px 0 8px 56px}
+.event-source{font-size:10px;color:#858a90;margin-bottom:4px}
+.event-content pre{white-space:pre-wrap;overflow:auto;max-height:160px;margin:0;padding:8px 9px;background:#f7f8f9;border:1px solid #eceef0;border-radius:6px;font:11px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace}
+.no-record{padding:14px;border:1px dashed #dfe2e5;border-radius:7px;color:#73787e;background:#fafbfc}
+@media(max-width:650px){.role-dialog{max-height:84dvh}.timeline-round>summary{align-items:flex-start;flex-direction:column;gap:3px}.timeline-round>summary em{margin:0;text-align:left}.event-content{margin-left:0}.timeline-event summary small{margin-left:0}}
+.role-chip.error .state-dot{background:#c84646}
+.role-chip.error .avatar{color:#9e2e2e;background:#fae7e7}
+.error-evidence{background:#fff2f1!important;border-color:#e4aaaa!important;color:#8f2828}
