+.tk-from{font-size:11.5px;color:var(--muted-foreground)}
+.tk-from b{color:var(--foreground);font-weight:500}
+.tk pre{margin:0;white-space:pre-wrap;overflow-wrap:anywhere;padding:8px 9px;border-radius:6px;background:var(--muted);font:11.5px/1.6 var(--mono)}
