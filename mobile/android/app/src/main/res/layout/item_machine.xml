<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/machineIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="14dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_laptop_outline"
        android:tint="#242638" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

    <TextView
        android:id="@+id/machineName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#161827"
        android:textSize="16sp"
        android:textStyle="normal" />

    <TextView
        android:id="@+id/machineStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:drawablePadding="5dp"
        android:drawableStart="@drawable/status_dot_online"
        android:textSize="14sp" />

    </LinearLayout>

    <RadioButton
        android:id="@+id/machineSelected"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:clickable="false"
        android:focusable="false"
        android:buttonTint="#5148EE" />
</LinearLayout>
